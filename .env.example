# API Keys for InvestIQ
# Rename this file to .env for local development

# RapidAPI Key (Universal for Yahoo, WSJ, etc.)
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE
RAPIDAPI_HOST_TRADING_ECONOMICS=trading-econmics-scraper.p.rapidapi.com
RAPIDAPI_HOST_YAHOO=yahoo-finance15.p.rapidapi.com
RAPIDAPI_HOST_WSJ=wall-street-journal.p.rapidapi.com
RAPIDAPI_HOST_TWITTER=twitter241.p.rapidapi.com
RAPIDAPI_HOST_ECO_CALENDAR=ultimate-economic-calendar.p.rapidapi.com
RAPIDAPI_HOST_LIVE_MARKET=live-stock-market.p.rapidapi.com
RAPIDAPI_HOST_BLOOMBERG=bloomberg-real-time.p.rapidapi.com

# NewsAPI Key
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
